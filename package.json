{
  "name": "tsukinowa-website",
  "private": true,
  "scripts": {
    "test": "node --test tests/works-data.test.cjs tests/works-model.test.cjs tests/photo-handler.test.cjs",
    "test:rules": "firebase emulators:exec --project demo-tsukinowa --only firestore,storage \"node --test tests/firebase-rules.test.cjs\"",
    "test:browser": "firebase emulators:exec --project demo-tsukinowa --only auth,firestore,storage \"node tests/works-browser.test.cjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "firebase": "12.4.0",
    "firebase-tools": "14.22.0",
    "playwright": "1.56.0",
    "firebase-admin": "13.5.0"
  }
}
