rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/worksAdmins/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/worksAdmins/$(request.auth.uid)).data.enabled == true;
    }
    match /works/{id}/{name} {
      // All raw file/metadata access is private. workPhoto serves published bytes only.
      allow get: if admin();
      allow list: if admin();
      allow create: if admin() && resource == null && id.matches('^[a-zA-Z0-9-]{1,80}$') &&
        name.matches('^(before|after)-[a-zA-Z0-9-]+[.](webp|jpg)$') &&
        request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024 &&
        ((name.matches('.*[.]webp$') && request.resource.contentType == 'image/webp') ||
          (name.matches('.*[.]jpg$') && request.resource.contentType == 'image/jpeg'));
      // New uploads have unique names: replacing a public photo in-place is forbidden.
      allow update: if false;
      allow delete: if admin();
    }
    match /{path=**} { allow read, write: if false; }
  }
}
